FROM golang:1.24.3-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY proto ./proto
COPY services/generator ./services/generator

RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/generator ./services/generator/cmd

FROM alpine:3.20

RUN apk add --no-cache ca-certificates

COPY --from=build /out/generator /app/generator

ENTRYPOINT ["/app/generator"]
