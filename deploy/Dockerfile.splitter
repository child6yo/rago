FROM golang:1.24.3-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY services/splitter ./services/splitter

RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/splitter ./services/splitter/cmd

FROM alpine:3.20

RUN apk add --no-cache ca-certificates

COPY --from=build /out/splitter /app/splitter

ENTRYPOINT ["/app/splitter"]
